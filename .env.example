# Copy to .env and replace every placeholder before starting the services.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
MYSQL_APP_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
MYSQL_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
MYSQL_MIGRATOR_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
MYSQL_READONLY_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
MONGODB_ROOT_USERNAME=crms_root
MONGODB_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
INGEST_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
WEB_PORT=3000
MYSQL_PORT=3306
MONGODB_PORT=27017
MYSQL_DATABASE=ai_crms
MYSQL_HOST=mysql
MYSQL_USER=crms_app
MYSQL_ADMIN_USER=crms_admin
MYSQL_MIGRATOR_USER=crms_migrator
MYSQL_READONLY_USER=crms_readonly
MONGODB_URI=mongodb://crms_root:REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE@mongodb:27017/?authSource=admin
MONGODB_DATABASE=ai_crms_monitoring
MODEL_ID=Xenova/all-MiniLM-L6-v2
NODE_ENV=development
